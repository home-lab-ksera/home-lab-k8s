logging {
  level = "info"
  format = "logfmt"
}

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label = "node"
  }
  rule {
    target_label = "cluster"
    replacement = "home-lab"
  }
}

loki.source.kubernetes "pods" {
  targets = discovery.relabel.pod_logs.output
  forward_to = [loki.process.retention.receiver]
}

// Loki の168時間制限に対し、転送遅延分の余裕を確保する。
loki.process "retention" {
  forward_to = [loki.write.local.receiver]
  stage.drop {
    older_than = "167h"
    drop_counter_reason = "older_than_retention"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  wal {
    enabled = true
  }
}

// 外形の疎通監視。クラスタ内 DNS → Gateway（TLS）→ 各アプリの応答と、Tailnet 向け Split DNS を1分ごとに確認する。
// 常駐 Pod を増やさないよう、Alloy 内蔵の blackbox exporter を使う。
prometheus.exporter.blackbox "endpoints" {
  // http_2xx_cluster_ca は API サーバー用。証明書はクラスタ CA の発行で公開 CA では検証できないため、
  // 検証を省いて応答と証明書の期限だけを見る。
  config = "{ modules: { http_2xx: { prober: http, timeout: 10s }, http_2xx_cluster_ca: { prober: http, timeout: 10s, http: { tls_config: { insecure_skip_verify: true } } }, dns_split: { prober: dns, timeout: 5s, dns: { query_name: blog.internal.qroksera.com, query_type: A } } } }"

  target {
    name    = "argocd"
    address = "https://argocd.internal.qroksera.com/healthz"
    module  = "http_2xx"
  }
  target {
    name    = "harbor"
    address = "https://harbor.internal.qroksera.com/api/v2.0/ping"
    module  = "http_2xx"
  }
  target {
    name    = "grafana"
    address = "https://grafana.internal.qroksera.com/api/health"
    module  = "http_2xx"
  }
  target {
    name    = "blog"
    address = "https://blog.internal.qroksera.com/"
    module  = "http_2xx"
  }
  target {
    name    = "cooklog"
    address = "https://cooklog.internal.qroksera.com/"
    module  = "http_2xx"
  }
  target {
    name    = "api-hub"
    address = "https://api-hub.internal.qroksera.com/health"
    module  = "http_2xx"
  }
  target {
    name    = "rsshub"
    address = "https://rsshub.internal.qroksera.com/healthz"
    module  = "http_2xx"
  }
  target {
    name    = "hitomi-upload-viewer"
    address = "https://hitomi-upload-viewer.internal.qroksera.com/health"
    module  = "http_2xx"
  }
  // kubeadm が発行する control-plane 証明書の期限を見る。/livez は匿名で取得できる。
  target {
    name    = "kube-apiserver"
    address = "https://kubernetes.default.svc/livez"
    module  = "http_2xx_cluster_ca"
  }
  target {
    name    = "split-dns"
    address = "192.168.122.101"
    module  = "dns_split"
  }
}

discovery.relabel "endpoints" {
  targets = prometheus.exporter.blackbox.endpoints.targets
  // job は integrations/blackbox/<name>。アラートで使う target ラベルへ名前だけを写す。
  rule {
    source_labels = ["job"]
    regex         = "integrations/blackbox/(.+)"
    target_label  = "target"
  }
  rule {
    target_label = "job"
    replacement  = "endpoint-probe"
  }
}

prometheus.scrape "endpoints" {
  targets         = discovery.relabel.endpoints.output
  scrape_interval = "60s"
  scrape_timeout  = "15s"
  forward_to      = [prometheus.relabel.endpoints.receiver]
}

prometheus.relabel "endpoints" {
  forward_to = [prometheus.remote_write.victoria_metrics.receiver]
  rule {
    source_labels = ["__name__"]
    regex         = "probe_success|probe_duration_seconds|probe_http_status_code|probe_ssl_earliest_cert_expiry"
    action        = "keep"
  }
}

prometheus.remote_write "victoria_metrics" {
  endpoint {
    url = "http://victoria-metrics:8428/api/v1/write"
  }
}
