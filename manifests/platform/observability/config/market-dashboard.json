          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH p AS (\n  SELECT trade_date, close::float8 AS c,\n         avg(close::float8) OVER (ORDER BY trade_date ROWS 49 PRECEDING) AS ma50,\n         avg(close::float8) OVER (ORDER BY trade_date ROWS 199 PRECEDING) AS ma200\n  FROM daily_prices\n  WHERE symbol = '$symbol' AND trade_date >= $__timeFrom()::date - 400 AND trade_date <= $__timeTo()::date)\nSELECT trade_date::timestamp AS time, c AS \"終値\", ma50 AS \"50 日平均\", ma200 AS \"200 日平均\"\nFROM p WHERE $__timeFilter(trade_date) ORDER BY 1"
        }
