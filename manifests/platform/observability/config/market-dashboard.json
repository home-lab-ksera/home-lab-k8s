    {
      "type": "stat",
      "title": "MVP（直近 15 営業日）",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "description": "M: 15 日のうち 12 日以上上昇 / V: 15 日目の出来高が 1 日目の 1.25 倍以上 / P: 16 営業日前の終値から +20% 以上。3 つすべてで「該当」。",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql-market"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH r AS (\n  SELECT trade_date, close::float8 AS c, volume::float8 AS v,\n         lag(close::float8) OVER (ORDER BY trade_date) AS prev,\n         row_number() OVER (ORDER BY trade_date DESC) AS rn\n  FROM daily_prices WHERE symbol = '$symbol' AND trade_date > CURRENT_DATE - 90),\nw AS (\n  SELECT count(*) FILTER (WHERE rn <= 15 AND c > prev) AS up,\n         max(v) FILTER (WHERE rn = 1) / nullif(max(v) FILTER (WHERE rn = 15), 0) AS vr,\n         max(c) FILTER (WHERE rn = 1) / nullif(max(c) FILTER (WHERE rn = 16), 0) - 1 AS pr,\n         count(*) AS n\n  FROM r WHERE rn <= 16)\nSELECT up AS \"上昇日数（15 日中）\", vr AS \"出来高倍率（15 日目 / 1 日目）\", pr AS \"株価変化率（16 営業日前比）\",\n       CASE WHEN n < 16 THEN '日足不足' WHEN up >= 12 AND vr >= 1.25 AND pr >= 0.2 THEN '該当' ELSE '非該当' END AS \"MVP\"\nFROM w"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
