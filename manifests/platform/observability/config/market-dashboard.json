          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT trade_date::text AS \"取引日\", close::float8 AS \"終値\", chg AS \"前日比\", volume AS \"出来高\",\n       CASE WHEN chg > 0 THEN '上昇' WHEN chg < 0 THEN '下落' ELSE '—' END AS \"方向\"\nFROM (\n  SELECT trade_date, close, volume,\n         close::float8 / nullif(lag(close::float8) OVER (ORDER BY trade_date), 0) - 1 AS chg\n  FROM daily_prices WHERE symbol = '$symbol' AND trade_date > CURRENT_DATE - 90) t\nORDER BY trade_date DESC LIMIT 15"
