    {
      "type": "table",
      "title": "${market_label} の MVP 指標（全構成銘柄）",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 14
      },
      "description": "満たした条件の数が多い順、同じなら株価変化率の高い順。銘柄をクリックすると、その銘柄を表示する。",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql-market"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH m AS (SELECT symbol, name FROM index_memberships WHERE market = '$market' AND removed_on IS NULL),\nr AS (\n  SELECT p.symbol, p.trade_date, p.close::float8 AS c, p.volume::float8 AS v,\n         lag(p.close::float8) OVER (PARTITION BY p.symbol ORDER BY p.trade_date) AS prev,\n         row_number() OVER (PARTITION BY p.symbol ORDER BY p.trade_date DESC) AS rn\n  FROM daily_prices p JOIN m USING (symbol) WHERE p.trade_date > CURRENT_DATE - 90),\nw AS (\n  SELECT symbol,\n         max(trade_date) FILTER (WHERE rn = 1) AS d,\n         max(c) FILTER (WHERE rn = 1) AS close,\n         count(*) FILTER (WHERE rn <= 15 AND c > prev) AS up,\n         max(v) FILTER (WHERE rn = 1) / nullif(max(v) FILTER (WHERE rn = 15), 0) AS vr,\n         max(c) FILTER (WHERE rn = 1) / nullif(max(c) FILTER (WHERE rn = 16), 0) - 1 AS pr,\n         count(*) AS n\n  FROM r WHERE rn <= 16 GROUP BY symbol)\nSELECT w.symbol AS \"銘柄\", m.name AS \"社名\", w.d::text AS \"取引日\", w.close AS \"終値\",\n       w.up AS \"上昇日数\", w.vr AS \"出来高倍率\", w.pr AS \"株価変化率\",\n       CASE WHEN w.n < 16 THEN '日足不足' WHEN w.up >= 12 AND w.vr >= 1.25 AND w.pr >= 0.2 THEN '該当' ELSE '' END AS \"MVP\"\nFROM w JOIN m USING (symbol)\nORDER BY (w.up >= 12)::int + (w.vr >= 1.25)::int + (w.pr >= 0.2)::int DESC, w.pr DESC NULLS LAST"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
