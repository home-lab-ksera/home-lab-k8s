          "rawQuery": true,
          "rawSql": "SELECT market AS \"指数\", name AS \"社名\", added_on::text AS \"組み入れ（検知日）\",\n       coalesce(removed_on::text, '—') AS \"除外（検知日）\"\nFROM index_memberships WHERE symbol = '$symbol' ORDER BY added_on DESC"
