{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "automerge": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "enabledManagers": [
    "kubernetes",
    "argocd",
    "custom.regex"
  ],
  "ignorePaths": [
    "**/charts/**",
    "**/upstream/**",
    "tasks/**",
    "automation/**"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^manifests/.+\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^manifests/bootstrap/applications/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "ローカル GitOps HEAD と自作 latest は固定する",
      "matchCurrentValue": "/^(HEAD|latest)$/",
      "enabled": false
    },
    {
      "description": "private Harbor のアプリ配布はアプリ側 workflow が管理",
      "matchPackageNames": [
        "/^harbor\\.qroksera\\.com\\//"
      ],
      "enabled": false
    },
    {
      "description": "major 更新は個別 PR で確認",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "ログ基盤の更新を同じ PR で検証",
      "matchPackageNames": [
        "grafana/loki",
        "grafana/alloy"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "logging stack"
    },
    {
      "description": "VictoriaMetrics と vmalert の版を揃える",
      "matchPackageNames": [
        "victoriametrics/victoria-metrics",
        "victoriametrics/vmalert"
      ],
      "groupName": "VictoriaMetrics"
    },
    {
      "description": "NGF の OCI source は chart 名を含むため lookup の重複を補正",
      "matchManagers": [
        "argocd"
      ],
      "matchPackageNames": [
        "ghcr.io/nginx/charts/nginx-gateway-fabric/nginx-gateway-fabric"
      ],
      "overridePackageName": "ghcr.io/nginx/charts/nginx-gateway-fabric"
    },
    {
      "description": "PostgreSQL は StatefulSet・バックアップ・Harbor の待機用クライアントを同じ版に揃える。major 更新は dump / restore が要るため自動では行わない",
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "groupName": "PostgreSQL",
      "automerge": false
    },
    {
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Kubernetes は minor を 1 つずつ PR にする（kubeadm は minor を飛ばせない）。マージがそのまま適用の承認になる",
      "matchPackageNames": [
        "kubernetes/kubernetes"
      ],
      "separateMultipleMinor": true,
      "minimumReleaseAge": "7 days",
      "commitMessageTopic": "Kubernetes",
      "prBodyNotes": [
        "**マージすると、ホストの `k8s-auto-upgrade.timer` が 1 時間以内（毎時 15 分）にクラスタを更新します。** API サーバーと worker の Pod が一時的に止まります。",
        "マージの前に: [CHANGELOG](https://github.com/kubernetes/kubernetes/tree/master/CHANGELOG) の Urgent Upgrade Notes と削除される API、Flannel・NGINX Gateway Fabric・ArgoCD・metrics-server が新しい版に対応しているか。手順と止まったときの対処は [docs/updates.md](https://github.com/home-lab-ksera/home-lab-k8s/blob/main/docs/updates.md#kubernetes)。"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "kubeadm クラスタの版。マージするとホストの k8s-auto-upgrade.timer が 1 時間以内に適用する",
      "managerFilePatterns": [
        "/^kubernetes-version\\.txt$/"
      ],
      "matchStrings": [
        "^(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s*$"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
