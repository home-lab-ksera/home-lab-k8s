# add-runner.sh が生成した呼び出し側 workflow。
# build・scan・Harbor への公開は home-lab-k8s の共通 workflow が行う（docs/app-delivery.md）。

name: Build and Push to Harbor - @@REPOSITORY@@

on:
  # 手動実行はテストとビルドのみ。公開は既定ブランチへの push で実行する。
  workflow_dispatch:
  push:
    branches: [ "@@BRANCH@@" ]
  pull_request:
    branches: [ "@@BRANCH@@" ]

permissions:
  contents: read

concurrency:
  group: harbor-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

jobs:
  # アプリ固有のテスト job をここに追加し、publish の needs に指定してください。

  publish:
    uses: home-lab-ksera/home-lab-k8s/.github/workflows/publish-harbor.yml@main
    permissions:
      contents: read
      id-token: write
    secrets: inherit
    with:
      image_name: "@@IMAGE@@"
